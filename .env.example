# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# --- DigitalOcean Managed PostgreSQL ----------------------------------------
# Full connection string from your cluster's "Connection Details" panel in
# the DigitalOcean Control Panel (Databases -> your cluster -> Connection
# Details -> Connection string). Looks like:
#   postgresql://doadmin:PASSWORD@app-xxxx-do-user-1234-0.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL=postgresql://doadmin:your_password@your-cluster-host.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# --- DigitalOcean Gradient AI Platform (serverless inference / LLM) --------
# Create a Model Access Key: Control Panel -> AI Platform -> Serverless
# Inference -> Model Access Keys.
DO_MODEL_ACCESS_KEY=your_model_access_key
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1/
# Confirm current model names for your account with:
#   GET https://inference.do-ai.run/v1/models  (Authorization: Bearer <key>)
DO_INFERENCE_MODEL=llama3.3-70b-instruct

# --- DigitalOcean Spaces (optional raw-CSV data lake) -----------------------
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=career-navigator-data
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# --- App ---------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
