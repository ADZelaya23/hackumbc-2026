# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# --- Snowflake -------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier        # e.g. abcd-xy12345
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CAREER_NAVIGATOR
SNOWFLAKE_SCHEMA=PUBLIC

# Model name available in your account/region for SNOWFLAKE.CORTEX.COMPLETE.
# Check current availability with: SHOW MODELS IN SNOWFLAKE.CORTEX;  (or account docs)
CORTEX_MODEL=llama3.1-70b

# --- DigitalOcean Spaces (optional data lake) -------------------------------
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=career-navigator-data
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# --- App ---------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
